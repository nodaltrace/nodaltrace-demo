# Copie para .env.local (fora do Git) e preencha com o token público do Mapbox (pk.…).
# Com ele, o mapa abre na imagem de satélite; sem ele, fica só no mapa neutro.
VITE_MAPBOX_TOKEN=

# Atestação na Solana: a página de verificação lê a conta direto deste RPC (padrão: devnet pública).
VITE_SOLANA_RPC=https://api.devnet.solana.com
# Endereço público da autoridade da credencial NODALTRACE (impresso pelo `setup` do attestor; o da devnet está no README,
# "Identidade publicada"). Com ele, a verificação deriva credencial e schema sem confiar no que a API informa; vazio, usa
# a autoridade que a API devolve (com aviso).
VITE_NT_AUTORIDADE=2B1bKsw9hg7BMF5BrUAEzeABB2a38ESKoNvzSUHaF5VF
